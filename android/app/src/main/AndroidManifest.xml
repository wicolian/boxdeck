<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:name=".BoxdeckApplication"
        android:allowBackup="false"
        android:label="boxdeck"
        android:theme="@style/Theme.Boxdeck">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="boxdeck" android:host="add" />
                <data android:scheme="boxdeck" android:host="box" />
                <data android:scheme="boxdeck" android:host="alert" />
            </intent-filter>
        </activity>
        <service
            android:name=".push.UnifiedPushReceiverService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
